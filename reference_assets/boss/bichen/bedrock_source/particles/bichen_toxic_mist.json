      "minecraft:particle_appearance_tinting": {"color": ["0.35 + variable.particle_random_1 * 0.15", 0.72, 0.21, "math.clamp(variable.particle_age * 4, 0, 1) * math.clamp(1 - variable.particle_age / variable.particle_lifetime, 0, 1) * 0.55"]}
