{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cultivation:shenyin_node_beam",
      "basic_render_parameters": {"material": "particles_add", "texture": "textures/particle/shenyin_thin_beam"}
    },
    "components": {
      "minecraft:emitter_rate_steady": {"spawn_rate": 3, "max_particles": 4},
      "minecraft:emitter_lifetime_looping": {"active_time": 2},
      "minecraft:emitter_shape_point": {"direction": [0, 1, 0]},
      "minecraft:particle_lifetime_expression": {"max_lifetime": "0.22 + variable.particle_random_4 * 0.18"},
      "minecraft:particle_initial_speed": 1.4,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [0.018, "0.18 + variable.particle_age * 0.7"],
        "facing_camera_mode": "lookat_y",
        "uv": {"texture_width": 8, "texture_height": 64, "uv": [0, 0], "uv_size": [8, 64]}
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.65 + 0.35 * math.cos(variable.particle_random_1 * 360)",
          "0.65 + 0.35 * math.cos(variable.particle_random_1 * 360 + 120)",
          "0.65 + 0.35 * math.cos(variable.particle_random_1 * 360 + 240)",
          "math.clamp(1 - variable.particle_age / variable.particle_lifetime, 0, 1)"
        ]
      }
    }
  }
}
