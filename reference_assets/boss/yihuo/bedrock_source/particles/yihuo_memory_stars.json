{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cultivation:yihuo_memory_stars",
      "basic_render_parameters": {"material": "particles_add", "texture": "textures/particle/yihuo_star"}
    },
    "components": {
      "minecraft:emitter_rate_steady": {"spawn_rate": 8, "max_particles": 24},
      "minecraft:emitter_lifetime_looping": {"active_time": 2},
      "minecraft:emitter_shape_sphere": {"offset": [0, 2.125, 0], "radius": 0.8, "direction": "outwards"},
      "minecraft:particle_lifetime_expression": {"max_lifetime": "0.5 + variable.particle_random_4 * 0.8"},
      "minecraft:particle_initial_speed": 0.08,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": ["0.025 + variable.particle_random_2 * 0.03", "0.025 + variable.particle_random_2 * 0.03"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {"texture_width": 16, "texture_height": 16, "uv": [0, 0], "uv_size": [16, 16]}
      },
      "minecraft:particle_appearance_tinting": {"color": ["0.8 + variable.particle_random_1 * 0.2", "0.84 + variable.particle_random_3 * 0.16", 1, "math.clamp(1 - variable.particle_age / variable.particle_lifetime, 0, 1) * (0.4 + 0.6 * math.abs(math.sin(variable.particle_age * 700)))"]}
