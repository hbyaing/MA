  "concepts": [
    {
      "id": "observation",
      "title": "辨药与证据",
      "requires": [],
      "practice": 0,
      "explanation": "公开药效是观测证据，不能据此断言原始投料。"
    },
    {
      "id": "conservation",
      "title": "药力守恒",
      "requires": [
        "observation"
      ],
      "practice": 0,
      "explanation": "产量与药效共用真实药力；堆量不能保证升品。"
    },
    {
      "id": "compatibility",
      "title": "配伍与部分约束",
      "requires": [
        "conservation"
      ],
      "practice": 0,
      "explanation": "同一目标允许不同材料路线，建议条件须实际试验。"
    },
    {
      "id": "thermal",
      "title": "火候与操作边界",
      "requires": [
        "conservation"
      ],
      "practice": 1,
      "explanation": "读懂工序不等于控制成功；实际批次包含失败与事故。"
    },
    {
      "id": "structure",
      "title": "成丹结构与合成",
      "requires": [
        "compatibility",
        "thermal"
      ],
      "practice": 3,
      "explanation": "合成先消耗真实提取物；连续温窗与资源竞争会改变结构，声明不是必成保证。"
    },
    {
      "id": "specials",
      "title": "特殊药效与资格",
      "requires": [
        "structure"
      ],
      "practice": 8,
      "explanation": "灵根、经脉与渡劫效果服用时仍复核既有资格、次数与状态，不靠品级跳过。"
    }
  ],
